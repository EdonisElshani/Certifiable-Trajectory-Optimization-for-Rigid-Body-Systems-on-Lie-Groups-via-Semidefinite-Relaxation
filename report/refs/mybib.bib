@article{Putinar1993Positive,
title = {Positive polynomials on semi-algebraic sets},
journal = {Comptes Rendus de l'Académie des Sciences - Series I - Mathematics},
volume = {328},
number = {7},
pages = {585-589},
year = {1999},
issn = {0764-4442},
doi = {https://doi.org/10.1016/S0764-4442(99)80251-1},
url = {https://www.sciencedirect.com/science/article/pii/S0764444299802511},
author = {Mihai Putinar and Florian-Horia Vasilescu},
abstract = {Structure theorems, in the spirit of E. Artin's Positivstellensatz, are obtained for certain positive polynomials on semi-algebraic subsets of the Euclidean space. The proofs use simple geometric constructions and a separation theorem of convex cones in topological vector spaces.
Résumé
On obtient des théorèmes de structure pour certains polynômes positifs sur des ensembles semi-algébriques de l'espace euclidien, dans l'esprit des résultats classiques de E. Artin. Les démonstrations font appel à la géométrie élémentaire et à une méthode de séparation des cônes convexes dans des espaces vectoriels topologiques.}
}

