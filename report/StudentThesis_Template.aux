\@writefile{lot}{\contentsline {table}{\numberline {6.3}{\ignorespaces Statistics of the Acrobot trajectory optimization using the \textbf  {Full SELF} sparsity setting (complete stage-wise cliques $I_k$) for desired absolute rotations of both links. The terminal rotation error is defined as $e_R(T) = \left ( \DOTSB \sum@ \slimits@ _{i=1}^{2} \left \|R_{i,N}-R_{i,\mathrm  {des}}\right \|_F^2 \right )^{1/2}$. The maximum manifold violation is $\varepsilon _{\mathrm  {SO(2)}}^{\max } = \max _{i,k,X\in \{R,F\}} \|X_{i,k}^{\top }X_{i,k}-I_2\|_F$. For each moment block $j$, $\delta _j$ denotes Teng's rank ratio $\delta _j=|\lambda _{j,2}|/|\lambda _{j,1}|$, where the eigenvalues are sorted by magnitude. Thus, $\delta _{\max }=\max _j\delta _j$, while $\delta _{\mathrm  {first}}$ is evaluated for the first moment block. All trajectory metrics use the ordered extraction, and the runtime is the solver operation time.}}{76}{table.caption.55}\protected@file@percent }
\newlabel{tab:acrobot_sdp_statistics_full}{{6.3}{76}{Statistics of the Acrobot trajectory optimization using the \textbf {Full SELF} sparsity setting (complete stage-wise cliques $I_k$) for desired absolute rotations of both links. The terminal rotation error is defined as $e_R(T) = \left ( \sum _{i=1}^{2} \left \|R_{i,N}-R_{i,\mathrm {des}}\right \|_F^2 \right )^{1/2}$. The maximum manifold violation is $\varepsilon _{\mathrm {SO(2)}}^{\max } = \max _{i,k,X\in \{R,F\}} \|X_{i,k}^{\top }X_{i,k}-I_2\|_F$. For each moment block $j$, $\delta _j$ denotes Teng's rank ratio $\delta _j=|\lambda _{j,2}|/|\lambda _{j,1}|$, where the eigenvalues are sorted by magnitude. Thus, $\delta _{\max }=\max _j\delta _j$, while $\delta _{\mathrm {first}}$ is evaluated for the first moment block. All trajectory metrics use the ordered extraction, and the runtime is the solver operation time}{table.caption.55}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.4}{\ignorespaces Statistics of the Acrobot trajectory optimization using the \textbf  {Hybrid SELF} sparsity setting, which preserves the first two full cliques and separates the later dynamics and kinematic constraints, for desired absolute rotations of both links. All metrics ($e_R(T)$, $\varepsilon _{\mathrm  {SO(2)}}^{\max }$, $\delta _{\max }$, $\delta _{\mathrm  {first}}$, and runtime) are defined as in Table~\ref {tab:acrobot_sdp_statistics_full}.}}{76}{table.caption.56}\protected@file@percent }
\newlabel{tab:acrobot_sdp_statistics_hybrid}{{6.4}{76}{Statistics of the Acrobot trajectory optimization using the \textbf {Hybrid SELF} sparsity setting, which preserves the first two full cliques and separates the later dynamics and kinematic constraints, for desired absolute rotations of both links. All metrics ($e_R(T)$, $\varepsilon _{\mathrm {SO(2)}}^{\max }$, $\delta _{\max }$, $\delta _{\mathrm {first}}$, and runtime) are defined as in Table~\ref {tab:acrobot_sdp_statistics_full}}{table.caption.56}{}}
